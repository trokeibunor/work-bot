# ==============================================================================
# JATE (Automated Job Acquisition & Tracking Engine) - Environment Template
# Copy this file to .env and populate your actual keys before running.
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Deployment Mode (Standalone VPS vs Coolify / Local)
# ------------------------------------------------------------------------------
# Set to 'proxy' if running standalone on a Linux VPS with built-in Nginx (Port 80):
# COMPOSE_PROFILES=proxy
# Leave commented or empty if running in Coolify (which manages Traefik/SSL automatically)
# or in local development.
COMPOSE_PROFILES=proxy
NGINX_PORT=80

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL 16 + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_USER=jate_admin
POSTGRES_PASSWORD=jate_secure_password_2026
POSTGRES_DB=jate_db
DATABASE_URL=postgresql+asyncpg://jate_admin:jate_secure_password_2026@db:5432/jate_db

# ------------------------------------------------------------------------------
# 3. Redis & Celery Message Broker
# ------------------------------------------------------------------------------
REDIS_PASSWORD=jate_redis_password_2026
REDIS_URL=redis://:jate_redis_password_2026@redis:6379/0
CELERY_BROKER_URL=redis://:jate_redis_password_2026@redis:6379/0
CELERY_RESULT_BACKEND=redis://:jate_redis_password_2026@redis:6379/1

# ------------------------------------------------------------------------------
# 4. LLM API Configuration (Gemini, OpenAI, or DeepSeek)
# ------------------------------------------------------------------------------
# Preferred: Google Gemini (Free tier available)
GEMINI_API_KEY=
# Alternative: DeepSeek API Key
DEEPSEEK_API_KEY=
# Fallback / Alternative: OpenAI API Key
OPENAI_API_KEY=
OPENAI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 5. Community Scrapers (Reddit & Hacker News)
# ------------------------------------------------------------------------------
# Reddit credentials are optional (falls back to anonymous public feed if blank)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=JATE-Bot/1.0.0 (by /u/candidate)

# ------------------------------------------------------------------------------
# 6. File Storage
# ------------------------------------------------------------------------------
STORAGE_DIR=/app/storage/pdfs

# ------------------------------------------------------------------------------
# 7. Networking, Domains & CORS
# ------------------------------------------------------------------------------
# Scenario A (Standalone VPS with Nginx on Port 80):
#   Leave NUXT_PUBLIC_API_BASE empty ("") so frontend uses relative "/api" paths.
#   CORS can be left as ["*"] or your domain/IP.
NUXT_PUBLIC_API_BASE=
CORS_ORIGINS=["*"]

# Scenario B (Coolify with 2 Subdomains, e.g. app.domain.com and api.domain.com):
# NUXT_PUBLIC_API_BASE=https://api.yourdomain.com
# CORS_ORIGINS=["https://app.yourdomain.com", "http://localhost:3000"]
